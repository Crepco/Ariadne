# Copy to .env and fill in. .env is git-ignored.

# --- Neo4j ---
# For Neo4j Aura (cloud), use the values from the credentials file Aura gives you
# when you create the instance. The URI scheme is neo4j+s:// (TLS).
# For a local Neo4j instead, use bolt://localhost:7687.
NEO4J_URI=neo4j+s://XXXXXXXX.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Domain name used for generated graphs (optional; defaults to ARIADNE.LOCAL).
DOMAIN=ARIADNE.LOCAL

# --- LLM providers (needed later, for the agent) ---
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
