# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# --- Neo4j -----------------------------------------------------------------
# Neo4j Aura (cloud): use the values from the credentials file Aura hands you
# when you create the instance. The URI scheme is neo4j+s:// (TLS).
# Local Neo4j instead (see infra/neo4j/): use bolt://localhost:7687.
NEO4J_URI=neo4j+s://XXXXXXXX.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Note: some Aura instances use the instance id (not "neo4j") for BOTH the
# username and the database name — set NEO4J_USER and NEO4J_DATABASE accordingly.

# Domain name used for generated graphs (optional; defaults to ARIADNE.LOCAL).
DOMAIN=ARIADNE.LOCAL

# --- LLM backend -----------------------------------------------------------
# The agent talks to one LLM. A backend is picked from whichever credentials are
# present: OpenRouter first, then Anthropic, then Gemini. Force one with
# LLM_PROVIDER=openrouter|anthropic|gemini.

# Native Anthropic (Claude) backend. Used when ANTHROPIC_API_KEY is set and no
# OpenRouter keys are.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=medium        # low | medium | high | xhigh | max
# ANTHROPIC_MAX_TOKENS=8000      # covers thinking + answer; don't set this low
#
# Note: current Claude models REJECT a sampling temperature (HTTP 400), so
# `run_benchmark.py --temperature` is a no-op on them — it is skipped rather
# than sent. For a variance sweep, use a model that still accepts it.

# OpenRouter (an OpenAI-compatible gateway to many models). Provide one or more
# comma-separated keys; multiple keys are rotated to spread rate limits.
OPENROUTER_API_KEYS=sk-or-...
OPENROUTER_MODEL=openai/gpt-4o-mini
# Cap the completion budget per call (the agent only emits small JSON). Prevents
# OpenRouter from reserving the model's full token budget against your balance.
OPENROUTER_MAX_TOKENS=512

# Optional native Gemini backend (used if no OpenRouter keys are set, or when
# LLM_PROVIDER=gemini). Free tier is rate-limited to ~15 requests/min.
# GEMINI_API_KEY=
# LLM_PROVIDER=openrouter        # force "openrouter" or "gemini"
# GEMINI_MAX_RPM=14              # client-side throttle for the Gemini free tier
